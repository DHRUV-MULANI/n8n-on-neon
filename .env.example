# Neon Postgres (use the UNPOOLED/direct host, not the -pooler host)
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=ep-xxxx.ap-southeast-1.aws.neon.tech
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_USER=neondb_owner
DB_POSTGRESDB_PASSWORD=
DB_POSTGRESDB_DATABASE=neondb
DB_POSTGRESDB_SCHEMA=public
DB_POSTGRESDB_SSL_ENABLED=true
DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=true

# Public origin n8n is served from
N8N_HOST=n8n.dhruvmulani.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.dhruvmulani.com/
N8N_EDITOR_BASE_URL=https://n8n.dhruvmulani.com/

# Generate once and keep stable: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Local runs only
N8N_PORT=5678
N8N_LISTEN_ADDRESS=0.0.0.0
