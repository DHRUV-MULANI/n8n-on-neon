# Neon Postgres (use the UNPOOLED/direct URL, not the -pooler host)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Public origin n8n is served from
N8N_HOST=n8n.dhruvmulani.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.dhruvmulani.com/
N8N_EDITOR_BASE_URL=https://n8n.dhruvmulani.com/

# Generate once and keep stable: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Local runs only
N8N_PORT=5678
N8N_LISTEN_ADDRESS=0.0.0.0
